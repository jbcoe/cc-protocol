module(
    name = "protocol",
    version = "0.0.1",
)

bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "googletest", version = "1.18.0")

# Only for the empty xcode_config in BUILD.bazel that build:macos selects.
bazel_dep(name = "apple_support", version = "1.24.2")
bazel_dep(name = "rules_python", version = "1.9.3")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")

# Python below is used in bazel for a generator, without deps.
# It does not need keeping in sync with pyproject.toml.
python.toolchain(python_version = "3.13")
