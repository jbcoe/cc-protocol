# Enable C++26 standard and GCC reflection
build --cxxopt=-std=c++26
build --cxxopt=-freflection

# Treat external repositories' headers (e.g. googletest) as system headers,
# matching CMake's SYSTEM FetchContent_Declare, so -Werror below only holds
# our own code to account and not warnings from vendored dependencies.
build --features=external_include_paths

# Match the warnings cmake/xyz_add_test.cmake applies to every test and
# tutorial, so a green Bazel build can't hide a warning the required CMake CI
# job would reject.
build --cxxopt=-Wall
build --cxxopt=-Werror
build --cxxopt=-Wno-self-assign-overloaded
build --cxxopt=-Wno-delete-non-abstract-non-virtual-dtor
build --cxxopt=-Wno-unknown-warning-option
build --cxxopt=-Wno-self-move

# Show test output on failure
test --test_output=errors

# Sanitizer builds, matching the flags cmake/sanitizers.cmake applies. Select
# one with `--config=asan`, `--config=ubsan`, or `--config=tsan`
# (`scripts/bazel.sh --asan/--ubsan/--tsan`). `--copt` rather than `--cxxopt`
# so external dependencies (googletest) are instrumented too, and `dbg` so
# sanitizer reports carry symbolised stack traces. ASAN and TSAN cannot be
# combined; ASAN and UBSAN can.
build:asan --compilation_mode=dbg
build:asan --copt=-fsanitize=address
build:asan --copt=-fno-omit-frame-pointer
build:asan --linkopt=-fsanitize=address

build:ubsan --compilation_mode=dbg
build:ubsan --copt=-fsanitize=undefined
build:ubsan --linkopt=-fsanitize=undefined

build:tsan --compilation_mode=dbg
build:tsan --copt=-fsanitize=thread
build:tsan --linkopt=-fsanitize=thread
