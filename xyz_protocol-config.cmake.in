@PACKAGE_INIT@

# The imported target carries the reflection flags of the compilers that
# implement C++26 reflection (P2996): GCC 16 or later and the clang-p2996
# fork. Report the requirement here rather than as an unknown-option error
# or a missing <meta> in the consumer's first compilation.
set(_xyz_protocol_compiler
    "${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION}")
if((CMAKE_CXX_COMPILER_ID STREQUAL "GNU" AND CMAKE_CXX_COMPILER_VERSION
                                             VERSION_LESS 16)
   OR NOT CMAKE_CXX_COMPILER_ID MATCHES "^(GNU|Clang)$")
  string(
    CONCAT
      xyz_protocol_NOT_FOUND_MESSAGE
      "xyz_protocol requires C++26 reflection, which the C++ compiler "
      "(${_xyz_protocol_compiler}) does not support. Use a GCC trunk "
      "snapshot (https://jwakely.github.io/pkg-gcc-latest/), gcc-16, or the "
      "clang-p2996 fork (https://github.com/bloomberg/clang-p2996).")
  set(xyz_protocol_FOUND FALSE)
  unset(_xyz_protocol_compiler)
  return()
endif()
unset(_xyz_protocol_compiler)

include("${CMAKE_CURRENT_LIST_DIR}/xyz_protocol-targets.cmake")

check_required_components(xyz_protocol)
