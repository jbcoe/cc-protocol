load("@apple_support//xcode:xcode_config.bzl", "xcode_config")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "name_mangling",
    hdrs = ["name_mangling.hh"],
)

cc_library(
    name = "protocol",
    srcs = [
        "conformance.hh",
        "conversion_thunks.hh",
        "member_function_thunks.hh",
        "operator_thunks.hh",
        "overload_spec.hh",
        "protocol_traits.hh",
        "protocol_wrappers.hh",
        "vtable.hh",
    ],
    hdrs = ["protocol.hh"],
    deps = [
        ":name_mangling",
    ],
)

cc_library(
    name = "consteval_check",
    hdrs = ["consteval_check.h"],
)

cc_test(
    name = "protocol_test",
    size = "small",
    srcs = [
        "allocator_tests.cc",
        "conformance_tests.cc",
        "consteval_check_test.cc",
        "forwarding_test.cc",
        "name_mangling_tests.cc",
        "protocol_member_function_tests.cc",
        "protocol_operator_tests.cc",
        "protocol_test.cc",
        "protocol_view_tests.cc",
        "tagged_allocator.h",
        "test_helpers.h",
        "tracking_allocator.h",
        "vtable_tests.cc",
    ],
    deps = [
        ":consteval_check",
        ":protocol",
        "@googletest//:gtest_main",
    ],
)

# An xcode_config with no Xcode versions. build:macos in .bazelrc selects it
# so the C++ toolchain does not fetch @local_config_xcode, which compiles and
# runs xcode-locator and then xcodebuild for every installed Xcode on each
# fresh output base.
xcode_config(name = "empty_xcode_config")
